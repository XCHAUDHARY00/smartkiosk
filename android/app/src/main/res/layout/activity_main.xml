<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    tools:context=".MainActivity">

    <!-- Primary Web Application View -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Network Error & Offline Fallback Overlay (Shown only if connectivity fails) -->
    <LinearLayout
        android:id="@+id/splash_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#ffffff"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Animated/Pulsing Hospital Logo -->
        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_smart_opd_logo"
            android:contentDescription="Smart OPD Logo"
            android:layout_marginBottom="16dp" />

        <!-- App Brand Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART OPD"
            android:textColor="#0f766e"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Clinical Intake &amp; Triage System"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Govt & ABDM Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ ABDM &amp; DPDP ACT COMPLIANT"
            android:textColor="#047857"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#ecfdf5"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Indeterminate Progress Indicator -->
        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#0f766e"
            android:layout_marginBottom="14dp" />

        <!-- Real-time Loading Status -->
        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opening Smart OPD Services..."
            android:textColor="#64748b"
            android:textSize="13sp"
            android:gravity="center" />

        <!-- Error / Retry Container (shown only on network failure) -->
        <LinearLayout
            android:id="@+id/splash_error_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/splash_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Could not connect to hospital server. Please check internet connection."
                android:textColor="#dc2626"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_splash_retry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Retry Connection"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#0f766e"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
